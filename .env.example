# DeepSeek API 配置(必填 DEEPSEEK_API_KEY,其余可选)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型:deepseek-chat(默认)/ deepseek-reasoner
MODEL_ID=deepseek-chat
# 备用模型:连续 overload(503)错误后自动切换
FALLBACK_MODEL_ID=
# LLM 请求超时(秒)
LLM_TIMEOUT=120

# ── 模型路由(混合路由:本地小模型 / API,不配置 LOCAL_* 时退化为纯 API) ──
# auto=全量路由;api-only=全走 API(逃生舱);local-only=全走本地(仅测试);shadow=只记录不生效(调参)
ROUTER_MODE=auto
# API 侧模型(默认取 MODEL_ID)
API_MODEL_ID=
# 本地小模型:24GB 机上 vLLM 服务的 QLoRA 微调模型(OpenAI 兼容接口)
LOCAL_MODEL_ID=
LOCAL_BASE_URL=
# 本地服务鉴权(vLLM 通常不需要,占位即可)
LOCAL_API_KEY=local
# 本地推理超时(秒,本地生成慢需放宽)
LOCAL_LLM_TIMEOUT=300
# Phase 3:路由轨迹收集开关(1=开启,落盘到 .training_data/,供 QLoRA 微调)
COLLECT_TRAINING_DATA=0

# ── 预算与配额 ──
# 单轮主循环上限(轮数 / 工具调用数 / 墙钟秒数 / 总 token;token=0 表示不限制)
TURN_MAX_ROUNDS=40
TURN_MAX_TOOL_CALLS=100
TURN_MAX_WALL_SECONDS=600
TURN_MAX_TOTAL_TOKENS=200000
# 子代理工具调用与墙钟上限
SUBAGENT_MAX_TOOL_CALLS=60
SUBAGENT_MAX_WALL_SECONDS=600
# 队友生命周期 / API 调用 / 认领任务 / 团队规模上限
TEAMMATE_MAX_LIFETIME_SECONDS=1800
TEAMMATE_MAX_API_CALLS=200
TEAMMATE_MAX_TASKS=20
MAX_TEAMMATES=5
# 后台任务并发、排队、单任务超时
BACKGROUND_MAX_CONCURRENT=4
BACKGROUND_MAX_QUEUED=16
BACKGROUND_TASK_TIMEOUT_SECONDS=600
# 任务租约(秒)与最大重试次数
TASK_LEASE_SECONDS=300
TASK_MAX_ATTEMPTS=3
# bash / 读文件 / MCP 上限
BASH_TIMEOUT_DEFAULT=120
BASH_TIMEOUT_MAX=600
READ_FILE_MAX_LINES=2000
MCP_CALL_TIMEOUT=60

# ── 沙箱(auto=有 bwrap 就用,require=没有就失败,off=关闭) ──
# 沙箱默认只读根 + 只写工作区/worktree + 无网络;网络命令需逐次确认
SANDBOX_MODE=auto
SANDBOX_MEMORY_MB=4096
SANDBOX_CPU_SECONDS=600

# ── 逐次确认逃生舱(仅非交互场景;格式: name 或 prefix*,逗号分隔) ──
# 警告:配置后控制面写/破坏性操作不再询问,请谨慎使用
AUTO_APPROVE_TOOLS=

# ── 定时任务上限 ──
CRON_MAX_JOBS=50
CRON_MAX_PROMPT_CHARS=2000
CRON_MIN_INTERVAL_MINUTES=5

# ── 审计日志(常开,按大小轮转) ──
AUDIT_MAX_BYTES=5000000
AUDIT_BACKUP_COUNT=3
