# DeepSeek API 配置(必填 DEEPSEEK_API_KEY,其余可选)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型:deepseek-chat(默认)/ deepseek-reasoner
MODEL_ID=deepseek-chat
# 备用模型:连续 overload(503)错误后自动切换
FALLBACK_MODEL_ID=
# LLM 请求超时(秒)
LLM_TIMEOUT=120

# ── 模型路由(混合路由:本地小模型 / API,不配置 LOCAL_* 时退化为纯 API) ──
# auto=全量路由;api-only=全走 API(逃生舱);local-only=全走本地(仅测试);shadow=只记录不生效(调参)
ROUTER_MODE=auto
# API 侧模型(默认取 MODEL_ID)
API_MODEL_ID=
# 本地小模型:24GB 机上 vLLM 服务的 QLoRA 微调模型(OpenAI 兼容接口)
LOCAL_MODEL_ID=
LOCAL_BASE_URL=
# 本地服务鉴权(vLLM 通常不需要,占位即可)
LOCAL_API_KEY=local
# 本地推理超时(秒,本地生成慢需放宽)
LOCAL_LLM_TIMEOUT=300
# Phase 3:路由轨迹收集开关(1=开启,落盘到 .training_data/,供 QLoRA 微调)
COLLECT_TRAINING_DATA=0

# ── 预算与配额 ──
# 单轮主循环上限(轮数 / 工具调用数 / 墙钟秒数 / 总 token;token=0 表示不限制)
TURN_MAX_ROUNDS=40
TURN_MAX_TOOL_CALLS=100
TURN_MAX_WALL_SECONDS=600
TURN_MAX_TOTAL_TOKENS=200000
# 子代理工具调用与墙钟上限
SUBAGENT_MAX_TOOL_CALLS=60
SUBAGENT_MAX_WALL_SECONDS=600
# 队友生命周期 / API 调用 / 认领任务 / 团队规模上限
TEAMMATE_MAX_LIFETIME_SECONDS=1800
TEAMMATE_MAX_API_CALLS=200
TEAMMATE_MAX_TASKS=20
MAX_TEAMMATES=5
# 后台任务并发、排队、单任务超时
BACKGROUND_MAX_CONCURRENT=4
BACKGROUND_MAX_QUEUED=16
BACKGROUND_TASK_TIMEOUT_SECONDS=600
# 任务租约(秒)与最大重试次数
TASK_LEASE_SECONDS=300
TASK_MAX_ATTEMPTS=3
# ── LoopGuard:空转/无进展/熔断/watchdog ──
# 总开关;local 仍只升级 API,API/plan 才会 nudge/stop
LOOP_GUARD_ENABLED=1
# API 模式同一调用/同一输出的提醒与停止阈值
LOOP_EXACT_REPEAT_NUDGE=2
LOOP_EXACT_REPEAT_STOP=3
LOOP_OBSERVATION_NUDGE=2
LOOP_OBSERVATION_STOP=3
# 按 error_code 的连续失败:提醒/停止
LOOP_ERROR_REFLECT=2
LOOP_ERROR_STOP=4
# ABAB/ABCABC 交替模式:提醒/停止(按调用次数)
LOOP_PINGPONG_REFLECT=4
LOOP_PINGPONG_STOP=6
# 连续无产出轮数:提醒/停止;local 达到阈值升级 API;plan 达到停止阈值走 replan
LOOP_NO_PROGRESS_REFLECT=3
LOOP_NO_PROGRESS_STOP=6
LOOP_LOCAL_NO_PROGRESS_ESCALATE=4
# 每轮最多注入的 LoopGuard 消息数与单条字符上限
LOOP_MAX_GUARD_MESSAGES=3
LOOP_GUARD_MESSAGE_CHARS=400
# Prompt/轨迹中展示的失败尝试组数;负记忆 7 天,只在 escalate/stop/重复失败时落盘
LOOP_FAILED_ATTEMPTS_MAX=5
LOOP_EVENTS_MAX=50
LOOP_MEMORY_TTL_SECONDS=604800
LOOP_MEMORY_REPEAT_FAILURES=3
LOOP_MEMORY_MAX_CHARS=1500
# 工具熔断:连续基础设施错误次数 / 冷却秒数 / 退避上限
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30
CIRCUIT_MAX_COOLDOWN_SECONDS=300
# 计划循环:loop_stopped 触发的 replan 次数 / 同失败签名跨 revision 次数
PLAN_LOOP_MAX_REPLANS=1
PLAN_LOOP_SIGNATURE_REPEATS=2
# 主循环 watchdog:轮询 / LLM / 工具 / 人工确认 / 收尾 / 工具无进展(秒;0=该阶段不自动取消)
LOOP_WATCHDOG_POLL_SECONDS=0.5
LOOP_WATCHDOG_LLM_SECONDS=330
LOOP_WATCHDOG_TOOL_SECONDS=660
LOOP_WATCHDOG_APPROVAL_SECONDS=0
LOOP_WATCHDOG_CLOSE_SECONDS=180
LOOP_WATCHDOG_NO_PROGRESS_SECONDS=300

# bash / 读文件 / MCP 上限
BASH_TIMEOUT_DEFAULT=120
BASH_TIMEOUT_MAX=600
READ_FILE_MAX_LINES=2000
MCP_CALL_TIMEOUT=60

# ── 沙箱(auto=有 bwrap 就用,require=没有就失败,off=关闭) ──
# 沙箱默认只读根 + 只写工作区/worktree + 无网络;网络命令需逐次确认
SANDBOX_MODE=auto
SANDBOX_MEMORY_MB=4096
SANDBOX_CPU_SECONDS=600

# ── 逐次确认逃生舱(仅非交互场景;格式: name 或 prefix*,逗号分隔) ──
# 警告:配置后控制面写/破坏性操作不再询问,请谨慎使用
AUTO_APPROVE_TOOLS=

# ── 定时任务上限 ──
CRON_MAX_JOBS=50
CRON_MAX_PROMPT_CHARS=2000
CRON_MIN_INTERVAL_MINUTES=5

# ── 审计日志(常开,按大小轮转) ──
AUDIT_MAX_BYTES=5000000
AUDIT_BACKUP_COUNT=3

# ── MemoryStore(记忆契约:去重/检索/touch/归档) ──
MEMORY_TOP_K=6
MEMORY_CONTEXT_CHARS=6000
MEMORY_ITEM_PROMPT_CHARS=1200
MEMORY_MAX_CONTENT_CHARS=4000
MEMORY_DEFAULT_CONFIDENCE=0.6
MEMORY_MAX_ITEMS_PER_NAMESPACE=5000
MEMORY_HALF_LIFE_DAYS=30
MEMORY_TOUCH_INTERVAL_SECONDS=60
MEMORY_INDEX_MAX_ITEMS=2000
MESSAGE_DEDUPE_LEDGER_MAX=2000
CASE_SEARCH_HALF_LIFE_DAYS=180

# ── 餐饮案例检索(P1;默认 lexical 保持 P0 行为) ──
# lexical|hybrid;hybrid = FTS5/BM25 + structured + RRF + heuristic rerank
CATERING_CASE_RETRIEVAL_MODE=lexical
# heuristic|off;off 仅用于对比诊断,纯 RRF 可能丢失 curated top1
CATERING_CASE_RERANK_MODE=heuristic
CATERING_CASE_RETRIEVAL_TIMEOUT_MS=300
# 生成侧注入模式:shadow(默认)/assist/augment
CATERING_CASE_RAG_MODE=shadow

# ── 情景数据 retention:过期压缩归档,不删除;training_data 默认不自动清理 ──
RETENTION_ENABLED=1
RETENTION_GRACE_SECONDS=3600
RETENTION_TRANSCRIPTS_DAYS=30
RETENTION_TRANSCRIPTS_MAX=500
RETENTION_TOOL_OUTPUTS_DAYS=7
RETENTION_TOOL_OUTPUTS_MAX=500
RETENTION_BACKUPS_DAYS=30
RETENTION_BACKUPS_MAX=200
# 训练数据默认关闭自动清理;置 1 后按天/数量归档到 archive/
RETENTION_TRAINING_DATA=0
RETENTION_TRAINING_DAYS=90
RETENTION_TRAINING_MAX=5000
TRANSCRIPT_SEARCH_MAX_FILES=200
TRANSCRIPT_SEARCH_MAX_BYTES=2000000
TRANSCRIPT_RECALL_MAX_BYTES=100000

# ── 多代理治理:RoleSpec / 协议 / 监控 / 团队预算 ──
# roles.json 覆盖内置角色;格式见 roles.example.json
MAX_ROLE_SPECS=64
# 计划审批等待上限(秒);无响应则队友 failed 并释放任务
PLAN_APPROVAL_TIMEOUT_SECONDS=300
# 协议请求 TTL / 最大 pending
PROTOCOL_REQUEST_TTL_SECONDS=600
PROTOCOL_MAX_PENDING=500
# LeadMonitor 周期、stale 队友、任务心跳、reclaim 宽限(秒)
TEAM_MONITOR_INTERVAL_SECONDS=5
TEAMMATE_STALE_SECONDS=900
LEAD_HEARTBEAT_TIMEOUT_SECONDS=30
TASK_HEARTBEAT_INTERVAL_SECONDS=60
TEAM_RECLAIM_GRACE_SECONDS=30
# 语义任务查重:精确指纹自动复用,该阈值只触发相似警告
TASK_DEDUPE_FUZZY_THRESHOLD=0.75
# 团队预算:0=不限制(当前进程会话内生效)
TEAM_MAX_TOKENS=0
TEAM_MAX_SPAWNS=0
TEAM_MAX_TASKS=0
TEAM_MAX_WALL_SECONDS=0
# Reviewer:默认走 API;允许本地小模型时置 1
REVIEW_ALLOW_LOCAL=0
REVIEW_MAX_DIFF_CHARS=20000
REVIEW_MAX_FINDINGS=20
# Integration:是否要求每个 source 已有 pass review
INTEGRATION_REQUIRE_REVIEW=0
INTEGRATION_MAX_SOURCES=20
INTEGRATION_MAX_OUTPUT_CHARS=20000
INTEGRATION_TIMEOUT_SECONDS=600

# ── 通用 Plan / PlanExecutor(Plan 工具仅 lead 可见) ──
# 计划级上限:步数 / 累计 token / 墙钟(秒);0=该维度不限制
PLAN_MAX_STEPS=20
PLAN_MAX_TOTAL_TOKENS=400000
PLAN_MAX_WALL_SECONDS=1800
# 每个步骤的 scoped ReAct 轮数与工具调用上限
PLAN_STEP_MAX_ROUNDS=20
PLAN_STEP_MAX_TOOL_CALLS=60
# 最大 revision 与失败自动 replan;审批拒绝/预算/校验/Planner 失败不会 replan
PLAN_MAX_REVISIONS=2
PLAN_AUTO_REPLAN=1
PLANNER_MAX_TOKENS=4096
