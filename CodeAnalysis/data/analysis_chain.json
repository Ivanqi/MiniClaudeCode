{
  "schema_version": 1,
  "name": "code_asset_security_pipeline",
  "description": "代码资产安全管控链:入库 → 资产盘点 → 静态扫描 → 安全自评估 → 运行环境审查 → 一键部署 → 部署验证 → 整改案例检索。安全团队可直接修改本文件调整步骤与阈值,无需改动代码。",
  "steps": [
    {
      "id": "inventory",
      "title": "代码资产盘点",
      "dimension": "inventory",
      "tool": "get_asset",
      "args": {"project_id": "{{project_id}}"},
      "when": "always",
      "rules": [
        {"metric": "module_count", "op": "ge", "threshold": 1, "verdict": "info",
         "summary": "盘点 {value} 个模块,语言 {analysis.languages},部署范围 {analysis.deploy_scope}"}
      ]
    },
    {
      "id": "static_scan",
      "title": "多语言静态扫描",
      "dimension": "static_scan",
      "tool": "scan_static",
      "args": {"project_id": "{{project_id}}"},
      "when": "always",
      "rules": [
        {"metric": "critical_count", "op": "ge", "threshold": 1, "verdict": "anomaly",
         "summary": "发现 {value} 个 critical 级漏洞,需优先整改"},
        {"metric": "total", "op": "ge", "threshold": 1, "verdict": "anomaly",
         "summary": "静态扫描发现 {value} 个安全问题(严重 {critical_count}/高危 {high_count}/中危 {medium_count}/低危 {low_count})"}
      ]
    },
    {
      "id": "assess",
      "title": "安全等级自评估",
      "dimension": "assess",
      "tool": "assess_security",
      "args": {"project_id": "{{project_id}}"},
      "when": "always",
      "rules": [
        {"metric": "level", "op": "in", "threshold": ["C", "D", "E"], "verdict": "anomaly",
         "summary": "安全等级 {value},低于部署要求(风险分 {analysis.score:.1f})"}
      ]
    },
    {
      "id": "env_review",
      "title": "动态运行环境审查",
      "dimension": "env_review",
      "tool": "review_env",
      "args": {"project_id": "{{project_id}}"},
      "when": "always",
      "rules": [
        {"metric": "issue_count", "op": "ge", "threshold": 1, "verdict": "anomaly",
         "summary": "运行环境发现 {value} 项配置问题,最高严重度 {analysis.max_severity}"}
      ]
    },
    {
      "id": "deploy",
      "title": "一键部署(云环境联动)",
      "dimension": "deploy",
      "tool": "deploy_asset",
      "args": {"project_id": "{{project_id}}"},
      "when": "always",
      "rules": [
        {"metric": "blocked", "op": "eq", "threshold": true, "verdict": "anomaly",
         "summary": "部署被拦截: {blocked_reason}"},
        {"metric": "status", "op": "eq", "threshold": "deployed", "verdict": "info",
         "summary": "部署成功,模块 {modules_deployed} 个,部署单号 {deploy_id}"}
      ]
    },
    {
      "id": "verify",
      "title": "部署验证(可用性/真实性/完整性)",
      "dimension": "verify",
      "tool": "verify_deployment",
      "args": {"project_id": "{{project_id}}", "deploy_id": "{{deploy_id}}"},
      "when": "deploy_done",
      "rules": [
        {"metric": "all_passed", "op": "eq", "threshold": true, "verdict": "info",
         "summary": "可用性/真实性/完整性复核全部通过"}
      ]
    },
    {
      "id": "case",
      "title": "历史整改案例检索",
      "dimension": "case",
      "tool": "search_cases",
      "args": {"project_id": "{{project_id}}", "symptom": "{{symptom}}"},
      "when": "any_anomaly",
      "rules": [
        {"metric": "match_count", "op": "ge", "threshold": 1, "verdict": "info",
         "summary": "检索到 {value} 个历史整改案例,可参考处置经验"}
      ]
    }
  ]
}
