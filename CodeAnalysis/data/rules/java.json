{
  "schema_version": 1,
  "language": "java",
  "extensions": [
    ".java"
  ],
  "rules": [
    {
      "rule_id": "CA-JAVA-SQLI-001",
      "name": "JDBC SQL 字符串拼接",
      "severity": "high",
      "likelihood": 0.9,
      "pattern": "[\\\"']\\s*(?:SELECT|INSERT|UPDATE|DELETE)\\b[^\\\"'\\n]{0,300}[\\\"']\\s*\\+\\s*[\\w\\\"']",
      "flags": "i",
      "not_match": "",
      "cwes": [
        "CWE-89"
      ],
      "owasp": "A03:2021",
      "iso27001": "A.8.28",
      "evidence_hint": "字符串拼接构造 SQL 语句",
      "fix": "改用 PreparedStatement 参数化查询"
    },
    {
      "rule_id": "CA-JAVA-CRYPTO-002",
      "name": "DES/ECB 等弱加密算法",
      "severity": "medium",
      "likelihood": 0.7,
      "pattern": "Cipher\\s*\\.\\s*getInstance\\s*\\(\\s*\\\"(?:DES|DESede|RC2|RC4)",
      "flags": "i",
      "not_match": "",
      "cwes": [
        "CWE-327"
      ],
      "owasp": "A02:2021",
      "iso27001": "A.8.24",
      "evidence_hint": "使用已淘汰的对称加密算法",
      "fix": "改用 AES-GCM 等强加密算法"
    },
    {
      "rule_id": "CA-JAVA-LOG-003",
      "name": "日志记录敏感字段",
      "severity": "medium",
      "likelihood": 0.6,
      "pattern": "log(?:ger)?\\s*\\.\\s*(?:info|debug|warn|error)\\s*\\([^)\\n]{0,140}?(?:password|passwd|pwd|idCard|cardNo)\\b",
      "flags": "i",
      "not_match": "",
      "cwes": [
        "CWE-532"
      ],
      "owasp": "A09:2021",
      "iso27001": "A.8.12",
      "evidence_hint": "日志输出含明文口令/证件号等敏感字段",
      "fix": "日志脱敏,禁止输出口令/证件号等敏感字段"
    }
  ]
}