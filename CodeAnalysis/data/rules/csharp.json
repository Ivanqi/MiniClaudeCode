{
  "schema_version": 1,
  "language": "csharp",
  "extensions": [
    ".cs"
  ],
  "rules": [
    {
      "rule_id": "CA-CS-SQLI-001",
      "name": "SqlCommand SQL 字符串拼接",
      "severity": "high",
      "likelihood": 0.8,
      "pattern": "[\\\"']\\s*(?:SELECT|INSERT|UPDATE|DELETE)\\b[^\\\"'\\n]{0,300}[\\\"']\\s*\\+\\s*[\\w\\\"']",
      "flags": "i",
      "not_match": "",
      "cwes": [
        "CWE-89"
      ],
      "owasp": "A03:2021",
      "iso27001": "A.8.28",
      "evidence_hint": "字符串拼接构造 SQL 语句",
      "fix": "改用参数化查询(SqlCommand 参数集合)"
    },
    {
      "rule_id": "CA-CS-CRYPTO-001",
      "name": "MD5 弱哈希用于口令散列",
      "severity": "high",
      "likelihood": 0.8,
      "pattern": "\\bMD5\\s*\\.\\s*(?:Create|ComputeHash|create)\\s*\\(|\\bnew\\s+MD5CryptoServiceProvider\\b",
      "flags": "i",
      "not_match": "",
      "cwes": [
        "CWE-328"
      ],
      "owasp": "A02:2021",
      "iso27001": "A.8.24",
      "evidence_hint": "使用 MD5 计算口令散列",
      "fix": "口令散列改用加盐慢哈希(bcrypt/argon2)"
    },
    {
      "rule_id": "CA-CS-DESER-002",
      "name": "BinaryFormatter 不安全反序列化",
      "severity": "high",
      "likelihood": 0.7,
      "pattern": "\\bnew\\s+BinaryFormatter\\s*\\(|\\bBinaryFormatter\\s+\\w+\\s*=\\s*new\\b",
      "flags": "i",
      "not_match": "",
      "cwes": [
        "CWE-502"
      ],
      "owasp": "A08:2021",
      "iso27001": "A.8.26",
      "evidence_hint": "使用 BinaryFormatter 反序列化不受信数据",
      "fix": "改用 DataContractJsonSerializer/System.Text.Json 并校验输入"
    },
    {
      "rule_id": "CA-CS-EXPOSE-003",
      "name": "异常堆栈直接返回前端",
      "severity": "medium",
      "likelihood": 0.5,
      "pattern": "return\\s+[^;\\n]{0,90}\\b(?:ex|e)\\s*\\.\\s*(?:Message|StackTrace|ToString)",
      "flags": "i",
      "not_match": "",
      "cwes": [
        "CWE-209"
      ],
      "owasp": "A05:2021",
      "iso27001": "A.8.4",
      "evidence_hint": "异常信息(堆栈)直接返回前端泄露内部实现",
      "fix": "统一错误处理,前端返回通用错误文案"
    }
  ]
}